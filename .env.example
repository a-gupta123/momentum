# Momentum — environment
#
# Every variable here is OPTIONAL. With an empty file the app boots into Guest
# Demo mode with a deterministic natural-language parser, which is the intended
# way to evaluate it: no account, no keys, no database.
#
# What you configure only adds capabilities. `lib/validation/server-env.ts`
# turns the presence of these values into a typed capability object, and the UI
# reflects it — see the mode badge in the sidebar.
#
# Copy to `.env.local` (git-ignored) and fill in what you need.


# ─── Supabase: accounts and a real database ──────────────────────────────────
#
# Set BOTH to enable email sign-in and swap the storage adapter from
# localStorage to Postgres with row-level security. Set NEITHER to stay in
# Guest Demo mode. Setting exactly one is treated as misconfiguration and
# refuses to silently fall back, because a half-configured auth path is how
# data ends up in the wrong place.
#
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (anon) key. Safe to expose: it is powerless without a session
# because every table is guarded by RLS. Never put the service-role key here —
# nothing in this app needs it, and `NEXT_PUBLIC_` would ship it to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ─── OpenAI: richer natural-language capture ─────────────────────────────────
#
# Set BOTH to upgrade capture from the deterministic chrono-node parser to
# structured-output interpretation. The AI never writes to the database: it
# returns typed, Zod-validated proposed actions that you review and confirm.
# With these unset, every capture feature still works — just with a simpler
# parser.
#
# Server-only. Deliberately not prefixed with NEXT_PUBLIC_.
OPENAI_API_KEY=
# No default model is hard-coded, because model names get retired. Pick a
# current one that supports structured outputs, e.g. gpt-4.1-mini.
OPENAI_MODEL=


# ─── Deployment ──────────────────────────────────────────────────────────────
#
# Absolute origin, used for OAuth redirect URLs and Open Graph metadata.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
